# ============================================================================
# Environment configuration template — copy to .env and fill in per environment.
# NEVER commit a real .env. This file is a template only.
#
# DEV: use local PostgreSQL (localhost:5433/angels_dev).
# STAGING: use an ISOLATED staging PostgreSQL — never production Supabase.
# PRODUCTION: not configured yet — do not deploy until approved.
# ============================================================================

# --- Database (PostgreSQL) ---
# DEV: local isolated PostgreSQL.
# STAGING: separate staging database with its own credentials.
# NEVER point this at production Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/angels_dev?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/angels_dev?schema=public

# --- NextAuth ---
# Unique per environment. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=generate-a-32-byte-hex-secret
NEXTAUTH_URL=http://localhost:3000

# --- Trusted-Device Admin Shortcut ---
# ADMIN_PIN: 6+ digit PIN shared out-of-band with the admin (phone/in-person).
#   Generate: node -e "console.log(require('crypto').randomInt(0,1000000).toString().padStart(6,'0'))"
# ADMIN_TRUST_SECRET: HMAC signing key for trusted-device tokens (min 32 chars).
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both are validated at server startup and never exposed to the browser, Git, or logs.
ADMIN_PIN=generate-a-6-digit-pin
ADMIN_TRUST_SECRET=generate-a-48-byte-hex-secret

# --- Cron Secret ---
# Used to authenticate the hourly rate-limit cleanup cron job.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=generate-a-32-byte-hex-secret

# --- Cloudinary (image uploads) ---
# STAGING: use a separate Cloudinary cloud with TEST credentials.
# Do NOT use production Cloudinary credentials in staging.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Clover (payment processing) ---
# STAGING: use Clover SANDBOX credentials only.
# Do NOT connect staging to production Clover.
CLOVER_MERCHANT_ID=
CLOVER_ACCESS_TOKEN=
CLOVER_API_KEY=
CLOVER_ENVIRONMENT=sandbox

# --- EasyPost (shipping) ---
# STAGING: use EasyPost TEST API key only.
# Do NOT connect staging to production EasyPost.
EASYPOST_API_KEY=
EASYPOST_ENVIRONMENT=test

# --- Supabase ---
# PRODUCTION ONLY — do not configure for dev or staging.
# The dev/staging environments use local/isolated PostgreSQL above.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
